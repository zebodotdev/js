{
  "name": "@inttegro/svelte",
  "version": "0.2.0",
  "description": "Svelte components for Inttegro hosted workflows",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@inttegro/js": "0.2.0"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zebodotdev/js.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://studio.inttegro.com/web/svelte",
  "author": "Inttegro Eng <engineering@inttegro.com> (https://inttegro.com)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "typedocOptions": {
    "entryPoints": [
      "dist/index.d.ts"
    ],
    "tsconfig": "typedoc.tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/package": "2.5.8",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  }
}
