{
  "name": "@inttegro/vue",
  "version": "0.1.0",
  "description": "Vue components for Inttegro hosted workflows",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inttegro/js": "0.1.0"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zebodotdev/js.git",
    "directory": "packages/vue"
  },
  "homepage": "https://studio.inttegro.com/sdks/vue",
  "author": "Inttegro Eng <engineering@inttegro.com> (https://inttegro.com)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "typedocOptions": {
    "entryPoints": [
      "src/index.ts"
    ]
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vue": "3.5.42"
  }
}
